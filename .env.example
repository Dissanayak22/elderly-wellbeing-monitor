# Application
APP_NAME=Elderly Wellbeing Monitor
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
PORT=8000

# Database (SQLite for local use; cloud deployments may later need PostgreSQL)
DATABASE_URL=sqlite:///./database/app.db

# CORS: localhost keeps working, and a deployed Vercel domain can be added here
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-app.vercel.app
# Backward compatibility for existing local setups
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI service
AI_DEMO_MODE=false
SEED_DEMO_DATA=true

# Optional modules (off by default)
ENABLE_BLOCKCHAIN_AUDIT=false
ENABLE_CLOUD_SYNC=false

# Frontend environment for Vite
VITE_API_BASE_URL=http://127.0.0.1:8000
